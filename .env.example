# sim-core — environment contract
#
# Copy to .env for local runs. NEVER commit a real .env.
# Consuming services (sim-staybase, sim-bookbridge, sim-pebblepay) document
# their own extra variables on top of these.

# Bearer token required by every /__control/* route and by the /admin SPA.
# Must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CONTROL_TOKEN=replace-me-with-a-long-random-string

# HTTP port the service listens on. Defaults to 3000.
PORT=3000

# --- docs engine (only used when config.docs.enabled is true) ---------------

# Directory for the docs SQLite database. Defaults to ./data (gitignored).
# On Render this must be the mount path of the service's persistent disk.
DATA_DIR=./data

# --- admin auth (v0.3.0, only used when config.adminAuth.enabled is true) ---
#
# Google-OIDC sign-in gate for the /admin SPA and its assets. HUMAN SURFACE
# ONLY: the domain API, /docs, /openapi.json, /health, webhook receivers and the
# bearer-authenticated /__control plane are never gated, because the platform
# polls the first three and automation drives the last with CONTROL_TOKEN.
#
# Leave ADMIN_AUTH_ENABLED unset for local dev — the gate is opt-in and the rest
# of these are only read when it is on.
ADMIN_AUTH_ENABLED=false

# OAuth 2.0 client credentials from the Google Cloud console. The client's
# authorized redirect URIs must include https://<host>/admin/auth/callback for
# every deployed service, plus http://localhost:3000/admin/auth/callback for
# local runs. See "Creating the Google OAuth client" in the README.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me-with-the-google-client-secret

# Google Workspace domain allowed to sign in. Checked against BOTH the id_token
# `hd` claim and the email suffix.
ADMIN_ALLOWED_DOMAIN=partnerapi.com

# Optional, comma-separated. Narrows access to specific addresses inside the
# domain. Unset means "anyone in the domain".
# ADMIN_ALLOWED_EMAILS=jake@partnerapi.com,florian@partnerapi.com

# HMAC key for the session cookie and the OAuth state. At least 32 characters,
# and DIFFERENT per service (a shared one makes one service's cookie valid on
# another). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-me-with-a-32-plus-character-random-string

# Optional. Session lifetime in hours; default 12.
# ADMIN_SESSION_TTL_HOURS=12

# --- webhooks (only used by services that receive them) ---------------------

# Shared secret the platform signs webhook deliveries with. Consumed by
# verifyPlatformWebhook; the value comes from the platform when the webhook
# endpoint is registered. sim-core never reads this itself — the consumer
# passes it in.
WEBHOOK_SECRET=replace-me-with-the-platform-webhook-secret
